# ─────────────────────────────────────────────────────────────────────────
# PRODUCTION environment template.
#
# The shipped `.env` in this repo is for LOCAL DEVELOPMENT ONLY
# (APP_ENV=local, APP_DEBUG=true — that's normal and safe for local work).
#
# Before deploying to a real server, copy THIS file to `.env` on that
# server and fill in the blanks. Do NOT deploy the local .env as-is —
# APP_DEBUG=true in production will leak stack traces, file paths, and
# .env values (including DB passwords) to anyone who triggers an error.
# ─────────────────────────────────────────────────────────────────────────

APP_NAME="Shuttle Hub"
APP_ENV=production
APP_KEY=                          # generate a NEW one on the server: php artisan key:generate
APP_DEBUG=false                   # MUST be false in production
APP_URL=https://your-real-domain.example

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_LEVEL=error                   # don't log debug-level noise in production

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true        # requires HTTPS — cookie is never sent over plain HTTP
SESSION_SAME_SITE=lax

QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=local

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
